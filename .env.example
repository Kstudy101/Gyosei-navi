# ============================================================
# 환경변수 템플릿 — 실제 값은 .env.local에 (커밋 금지, .gitignore 처리됨)
# 원칙: 시크릿 하드코딩 금지 (docs/youtube.md §2)
#   - 브라우저에 노출돼도 되는 계측 ID만 NEXT_PUBLIC_ 접두사 사용
#   - 서버 전용 시크릿에는 절대 NEXT_PUBLIC_ 을 붙이지 않는다
# ============================================================

# Google Analytics 4 측정 ID (예: G-XXXXXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity 프로젝트 ID
NEXT_PUBLIC_CLARITY_ID=

# Google AdSense 클라이언트 ID (예: ca-pub-XXXXXXXXXXXXXXXX) — public/ads.txt 와 세트
NEXT_PUBLIC_ADSENSE_CLIENT=

# --- 자료수집 파이프라인 (docs/07) — 서버/스크립트 전용 ---
# e-Stat API アプリケーションID (https://www.e-stat.go.jp/api/ で取得, 無料)
ESTAT_APP_ID=

# --- Rakuten Affiliate (docs 작업지시서 — Rakuten Affiliate 2종 통합) ---
# Feature Flag: 미설정이면 true(활성). "false" 또는 "0"일 때만 비활성화
# 전체 스위치 — false면 아래 두 플래그와 무관하게 Rakuten 광고 전체 비표시
RAKUTEN_AFFILIATE_ENABLED=
# 楽天ウェブサービスAPI 콘텐츠 연관 상품 추천 (기사 중간)
RAKUTEN_API_AD_ENABLED=
# 楽天モーションウィジェット (기사 하단)
RAKUTEN_MOTION_WIDGET_ENABLED=

# Rakuten Web Service アプリID (https://webservice.rakuten.co.jp/ で取得, 無료)
# scripts/fetch-rakuten-products.ts 전용 — 클라이언트 번들에는 포함되지 않음
RAKUTEN_APP_ID=
# アフィリエイトID — Web Service API의 affiliateUrl 생성 + Motion Widget 양쪽에서 사용
# (Motion Widget은 브라우저에서 실행되는 위젯이라 렌더링된 HTML에 값 자체는 노출됨 — 비밀값 아님)
RAKUTEN_AFFILIATE_ID=
# Rakuten モーションウィジェット 발급 시 부여되는 위젯 인스턴스 식별자(rakuten_ts)
RAKUTEN_MOTION_WIDGET_ID=

# --- Phase 1 (LINE 연동 시) — 서버 전용 시크릿 ---
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
